# Local-dev fallback for external analytics (copy to client/.env — gitignored).
#
# In production DO NOT use these: set the server env vars instead —
# UMAMI_WEBSITE_ID, UMAMI_SRC, UMAMI_DOMAINS, GA_GAME_KEY, GA_SECRET_KEY —
# in the hosting panel (Timeweb App Platform → app → environment variables).
# The server serves them to the client at runtime via GET /config.js, which
# always wins over the VITE_ values baked in at build time.
#
# No real ids, keys, or domains belong in tracked files — env only.

# Umami (open-source web analytics): website ID from cloud.umami.is
VITE_UMAMI_WEBSITE_ID=
# Only needed for a self-hosted Umami; defaults to https://cloud.umami.is/script.js
VITE_UMAMI_SRC=
# Comma-separated hostnames Umami should record (blocks localhost noise),
# e.g. play.example.com,preview.example.com
VITE_UMAMI_DOMAINS=

# GameAnalytics (gameanalytics.com): keys from your game's settings page.
# Both are client-side keys — they ship in the JS bundle by design.
VITE_GA_GAME_KEY=
VITE_GA_SECRET_KEY=
